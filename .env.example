# Copy to .env for local development. Keep all real values out of Git.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
LOVABLE_PREVIEW_HOST=

# Google browser keys are public by nature: restrict allowed APIs and referrers.
# Prefer configuring these in your deployment environment, not in committed files.
GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACES_API_KEY=
