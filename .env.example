# CARONAA: configure valores reais somente no ambiente ou .env local ignorado.
# Servidor: Google Routes, Places e Geocoding.
GOOGLE_MAPS_API_KEY=
# Opcional: credencial específica para Places/Geocoding.
GOOGLE_PLACES_API_KEY=

# Chave pública de navegador, fornecida pela função de servidor.
# Restringir por HTTP referrers e APIs no Google Cloud.
GOOGLE_MAPS_BROWSER_API_KEY=

# Alternativas públicas de build, usadas depois das duas variáveis do servidor.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Android piloto: JSON público com versionCode, versionName e downloadUrl.
# Hospede o APK assinado em https://downloads.caronaa.com/android/ antes de anunciar.
CARONAA_ANDROID_RELEASE=
